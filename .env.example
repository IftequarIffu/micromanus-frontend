# Same Supabase project as the micromanus backend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave unset in local dev so requests use the Vite proxy (backend has no CORS).
# Only set this if the API serves CORS headers (e.g. production).
# VITE_API_URL=http://localhost:4000
